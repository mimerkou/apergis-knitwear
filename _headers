# Netlify headers · Stage 1 preview
# PREVIEW: the X-Robots-Tag line keeps the preview out of search engines. Remove it at launch.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=604800

# Keep at launch: the form confirmation page stays out of search results
/epikoinonia-efcharistoume*
  X-Robots-Tag: noindex
